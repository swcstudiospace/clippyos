{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClippyOS",
  "version": "1.0.0",
  "identifier": "space.swcstudio.clippyos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "npm run desktop:server",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "ClippyOS",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../dist-desktop/server": "server/"
    },
    "publisher": "ClippyOS",
    "category": "Business",
    "shortDescription": "Autonomous Operating System for Clipping",
    "longDescription": "ClippyOS is the production agency OS for clipping: clients, money, production, publishing, and a client portal with a leashed autonomy layer controlled via MCP by an agent."
  }
}
