# Set these in Vercel. Never commit real values.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY is an alias of SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://os.swcstudio.space
APP_URL=https://os.swcstudio.space
# Grok broker Google/X (per-app client). Required for Continue with Google/X on published hosts.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
# Native Google social (optional). Redirect: https://os.swcstudio.space/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native X/Twitter social (optional). Redirect: https://os.swcstudio.space/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
CRON_SECRET=
# Optional S3-compatible overflow (Filebase / Storj / R2)
LIBRARY_S3_ENDPOINT=https://s3.filebase.com
LIBRARY_S3_REGION=us-east-1
LIBRARY_S3_BUCKET=
LIBRARY_S3_ACCESS_KEY=
LIBRARY_S3_SECRET=
# Optional IPFS pin layer (Pinata). Never the write backend.
PINATA_JWT=
LIBRARY_IPFS_GATEWAY=https://ipfs.filebase.io/ipfs/
# Optional liaison channels (also operator-saved in Settings)
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Daytona key is operator-saved in Settings, not required here.
